{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergePatch",
    ":automergeMinor",
    ":automergeDigest",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "assignees": [
    "FaserF"
  ],
  "packageRules": [
    {
      "description": "Automatically merge all minor and patch updates once CI is green",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions dependencies",
      "automerge": true
    },
    {
      "description": "Group Python dev / test dependencies",
      "groupName": "python test & lint dependencies",
      "automerge": true,
      "matchPackageNames": [
        "/pytest/",
        "/ruff/",
        "/mypy/",
        "/coverage/"
      ]
    },
    {
      "description": "Group Home Assistant dependencies",
      "groupName": "home-assistant dependencies",
      "automerge": false,
      "matchPackageNames": [
        "/homeassistant/",
        "/pytest-homeassistant-custom-component/"
      ]
    }
  ]
}
